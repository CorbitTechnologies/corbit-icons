{
  "name": "corbit-icons-react",
  "version": "1.0.0",
  "description": "Corbit Icons as React components",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "svgr --out-dir src svgs --ext jsx",
    "build": "npm run generate && tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "react": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  }
}
