{
  "name": "corbit-icons",
  "version": "1.1.0",
  "description": "Core SVG metadata and utilities for Corbit Icons",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.mjs",
      "require": "./dist/icons.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build && npm audit --audit-level=high"
  },
  "devDependencies": {
    "svgo": "^4.0.1",
    "tsup": "^8.0.2",
    "typescript": "^5.0.0"
  }
}
